TELEGRAM_BOT_TOKEN=put-your-bot-token-here
# REQUIRED for real sending. If this is missing or true, NOTHING is sent (dry run).
SCHEDULER_DRY_RUN=false
# How often the sender checks for due messages (seconds)
SERVER_POLL_SECONDS=5
# Timezone for dates typed without an offset, e.g. 2026-10-22 15:30
APP_TIMEZONE=Asia/Kolkata
# Reminders overdue by more than this many minutes are skipped instead of sent late (0 = never skip)
SCHEDULER_MAX_LATE_MINUTES=1440
